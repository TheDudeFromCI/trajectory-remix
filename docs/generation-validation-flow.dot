digraph generation {
  graph [rankdir=TB, bgcolor="white", fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Trajectory creation and independent validation\nBlue: content LLM | Gray: deterministic | Orange: explicit validation | Purple: external review", pad=0.3, nodesep=0.3, ranksep=0.4];
  node [shape=box, style="rounded,filled", fillcolor="#F1F5F9", color="#64748B", fontname="DejaVu Sans", fontsize=13, margin="0.16,0.1"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#475569"];
  inputs [label="Select user_scenario (default) or idle_scenario\nRandomize scenario tags and role traits; accept manual inputs"];
  world [label="Generate workspace and original requirements\nFiles, policy/context, situation and success criteria\nOne bounded content request", fillcolor="#DBEAFE", color="#2563EB"];
  setup [label="Seed external world invisibly; initialize context windows\nSave original requirements, roles, tags and review checklist"];
  user [label="user_scenario\nGenerate user message → append as external input\nGenerate private notes + parallel tool decisions\nCompile and execute actual tool observations\nGenerate grounded notes + chat reply + continuation choice", fillcolor="#DBEAFE", color="#2563EB"];
  idle [label="idle_scenario\nNo user or chat\nGenerate private notes + parallel tool decisions\nCompile and execute actual tool observations\nChoose obsolete windows to release and whether finished", fillcolor="#DBEAFE", color="#2563EB"];
  repeat [label="Continue within flow limit?", shape=diamond];
  assemble [label="Code constructs replay, ticks and window lifecycle\nCompiler checks causality, tool results and loss masks\nPersist every proposal, checkpoint and diagnostic"];
  pending [label="Save Pending candidate (level 0)\nAlso retain incomplete / failed proposals for repair\nNo semantic model review or automatic repair in creation"];
  review [label="Optional explicit validation of selected saved trajectory\nEdit > Generation > Validate Trajectory\nOr MCP validate_trajectory(semantic=true), read-only\nShared review categories + saved original requirements\nBounded evidence requests; resumable independent journal", fillcolor="#FFEDD5", color="#EA580C"];
  verdict [label="Complete result?", shape=diamond, fillcolor="#FFEDD5", color="#EA580C"];
  record [label="If recording enabled: Validated (2) or Rejected (-2)\nSource unchanged; never grants Ready", fillcolor="#FFEDD5", color="#EA580C"];
  incomplete [label="Keep incomplete review and diagnostics\nNo new verdict; cancel/resume available", fillcolor="#FFEDD5", color="#EA580C"];
  external [label="External MCP review / targeted repair / sign-off\nAlways evaluate current source against original requirements\nEdits invalidate prior review", fillcolor="#EDE9FE", color="#7C3AED"];
  ready [label="Human Ready approval (level 3) → Training export", fillcolor="#EDE9FE", color="#7C3AED"];
  {rank=same; user; idle;}
  inputs -> world -> setup;
  setup -> user; setup -> idle;
  user -> assemble; idle -> assemble;
  assemble -> repeat;
  repeat -> user [label="User: next exchange"];
  repeat -> idle [label="Idle: next decision"];
  repeat -> pending [label="Finished / limit / failure"];
  pending -> review [label="Explicit action only"];
  pending -> external [label="API-free review"];
  review -> verdict;
  verdict -> record [label="Yes"];
  verdict -> incomplete [label="No"];
  record -> external; incomplete -> external;
  external -> external [label="Repair → compile → rereview"];
  external -> ready;
}
